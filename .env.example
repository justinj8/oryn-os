# Oryn OS runs fully offline with no .env at all. Set these only to switch on real providers.

# --- LLM: use Claude instead of the deterministic offline Replay model
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# DEFAULT_MODEL=claude-opus-5-5

# --- Twilio SMS + voice (point your Twilio number's webhooks at PUBLIC_BASE_URL/api/webhooks/<tenant>/twilio/{sms,voice})
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=+15555550100
# PUBLIC_BASE_URL=https://your-tunnel.example.com

# --- Email via SMTP
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# SMTP_FROM=agents@yourcompany.com

# --- Sandbox fault injection (demo retries)
# SANDBOX_FAILURE_RATE=0.2
# SANDBOX_LATENCY_MS=150
